# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase DB (for Prisma)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# TRON Blockchain
NEXT_PUBLIC_TRON_FULL_HOST=https://nile.trongrid.io
NEXT_PUBLIC_TRON_NETWORK=nile

# Smart Contract Addresses (deploy แล้วเติม)
NEXT_PUBLIC_TRPB_TOKEN_ADDRESS=
NEXT_PUBLIC_JOB_ESCROW_ADDRESS=
NEXT_PUBLIC_SKILL_CREDENTIAL_ADDRESS=
NEXT_PUBLIC_STUDENT_REPUTATION_ADDRESS=
NEXT_PUBLIC_DONATION_FUND_ADDRESS=
NEXT_PUBLIC_MENTORSHIP_MANAGER_ADDRESS=
