generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== Users ====================

enum UserRole {
  student
  employer
  admin
  teacher
  donor
  superadmin
  project_staff  // คณะทำงานใต้ร่มพระบารมี
  rmutl_staff    // คณะทำงาน มทร.ล้านนา (ผู้ว่าจ้างเทียม+ผู้ประเมิน)
}

enum ApprovalStatus {
  PENDING    // รอยืนยัน
  APPROVED   // ยืนยันแล้ว
  REJECTED   // ปฏิเสธ
  SUSPENDED  // ระงับชั่วคราว
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  role            UserRole       @default(student)
  name            String
  campus          String         @default("huaykaew")
  wallet_address  String?        @unique
  is_active       Boolean        @default(true)
  email_verified  Boolean        @default(false)
  approval_status ApprovalStatus @default(PENDING)
  approved_by     String?        // user id ที่ยืนยัน
  approved_at     DateTime?
  // ข้อมูลเพิ่มเติมตาม role
  student_id_card String?        // รหัสนักศึกษา
  faculty         String?        // คณะ/สาขา
  year_level      Int?           // ชั้นปี (สำหรับ student)
  organization    String?        // ชื่อหน่วยงาน/บริษัท (employer/donor)
  org_registration String?       // เลขทะเบียน/เลขผู้เสียภาษี
  org_address     String?        // ที่อยู่หน่วยงาน
  staff_position  String?        // ตำแหน่ง (staff roles)
  teacher_id_card String?        // รหัสอาจารย์
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  deleted_at      DateTime?

  // Relations
  student_tier         StudentTier?
  student_qualification StudentQualification?
  student_availability  StudentAvailability?
  jobs_as_employer     Job[]          @relation("EmployerJobs")
  jobs_as_student      Job[]          @relation("StudentJobs")
  jobs_as_mentor       Job[]          @relation("MentorJobs")
  evaluations_given    Evaluation[]   @relation("TeacherEvaluations")
  evaluations_received Evaluation[]   @relation("StudentEvaluations")
  donations            DonationFund[]
  behavior_logs        BehaviorLog[]
  // Reviews
  employer_given_reviews        EmployerReview[] @relation("EmployerGivenReviews")
  student_received_employer_reviews EmployerReview[] @relation("StudentReceivedEmployerReviews")
  student_given_reviews         StudentReview[]  @relation("StudentGivenReviews")
  employer_received_student_reviews StudentReview[] @relation("EmployerReceivedStudentReviews")
  mentor_given_reviews          MentorReview[]   @relation("MentorGivenReviews")
  trainee_received_reviews      MentorReview[]   @relation("TraineeReceivedReviews")
  // Credentials
  student_credentials           StudentCredential[] @relation("StudentCredentials")
  certifier_credentials         StudentCredential[] @relation("CertifierCredentials")
  assignment_requests           JobAssignmentRequest[] @relation("StudentAssignmentRequests")

  @@map("skc_users")
}

// ==================== Student Tier System ====================

enum TierLevel {
  trainee
  apprentice
  certified
}

model StudentTier {
  id                     String    @id @default(uuid())
  student_id             String    @unique
  tier                   TierLevel @default(trainee)
  training_jobs_completed Int      @default(0)
  avg_mentor_score       Float     @default(0)
  safety_incidents       Int       @default(0)
  promoted_at            DateTime?
  student                User      @relation(fields: [student_id], references: [id])

  @@map("skc_student_tiers")
}

enum BadgeLevel {
  LOCKED
  BASIC
  TRUSTED
  ELITE
}

// ==================== Credential System (5 Levels) ====================

enum CredentialLevel {
  LEVEL_1  // Registered
  LEVEL_2  // Project Certified (ใต้ร่มพระบารมี)
  LEVEL_3  // Teacher Certified (อาจารย์ มทร.ล้านนา)
  LEVEL_4  // National Certified (กรมฝีมือแรงงาน/สคช.)
  LEVEL_5  // Master Technician (รับเหมา+สอน+รับรองผู้อื่น)
}

enum CertifyingBody {
  SYSTEM           // ระบบอัตโนมัติ
  PROJECT_BARAMEE  // กลุ่มใต้ร่มพระบารมี
  RMUTL_TEACHER    // อาจารย์ มทร.ล้านนา
  DSD              // กรมพัฒนาฝีมือแรงงาน
  TPQI             // สถาบันคุณวุฒิวิชาชีพ
  MASTER_TECH      // Master Technician (Lv.5 รับรอง)
}

enum EvalPhase {
  PRE_WORK     // ก่อนเริ่มงาน
  IN_PROGRESS  // ระหว่างทำงาน
  POST_WORK    // หลังงานเสร็จ
}

model StudentCredential {
  id                  String          @id @default(uuid())
  student_id          String
  credential_level    CredentialLevel @default(LEVEL_1)
  certified_by        CertifyingBody  @default(SYSTEM)
  certified_by_user_id String?
  certificate_ref     String?
  specialization      String?
  issued_at           DateTime        @default(now())
  expires_at          DateTime?
  nft_tx_hash         String?
  is_active           Boolean         @default(true)
  created_at          DateTime        @default(now())

  student       User  @relation("StudentCredentials", fields: [student_id], references: [id])
  certified_by_user User? @relation("CertifierCredentials", fields: [certified_by_user_id], references: [id])

  @@index([student_id])
  @@index([credential_level])
  @@map("skc_student_credentials")
}

model StudentQualification {
  id              String     @id @default(uuid())
  student_id      String     @unique
  total_jobs      Int        @default(0)
  avg_score       Float      @default(0)
  success_rate    Float      @default(0)
  badge_level     BadgeLevel @default(LOCKED)
  max_job_value   Float      @default(0)
  suspended_until DateTime?
  student         User       @relation(fields: [student_id], references: [id])

  @@map("skc_student_qualifications")
}

enum AvailabilityStatus {
  available
  busy
  unavailable
}

model StudentAvailability {
  student_id   String             @id
  status       AvailabilityStatus @default(available)
  busy_until   DateTime?
  current_jobs Int                @default(0)
  location     String?
  student      User               @relation(fields: [student_id], references: [id])

  @@map("skc_student_availability")
}

// ==================== Jobs ====================

enum JobType {
  PAID
  VOLUNTEER
  TRAINING
  EXEMPTED
}

enum JobStatus {
  OPEN
  ASSIGNED
  CONFIRMED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum HiringMode {
  MODE_A
  MODE_B
  MODE_C
}

enum JobCategory {
  electrical
  hvac
  automotive
  general
}

model Job {
  id            String      @id @default(uuid())
  title         String
  description   String
  type          JobType
  job_category  JobCategory
  status        JobStatus   @default(OPEN)
  hiring_mode   HiringMode  @default(MODE_A)
  is_mentorship Boolean     @default(false)
  location      String
  campus        String
  pay_amount    Float       @default(0)
  deadline      DateTime
  employer_id   String
  student_id    String?
  mentor_id     String?
  escrow_tx          String?
  eval_window_start  DateTime?
  eval_window_end    DateTime?
  eval_window_days   Int         @default(7)
  // Staff assignment & schedule lifecycle
  approved_by_staff             String?
  staff_approval_at             DateTime?
  work_start_date               DateTime?
  work_end_date                 DateTime?
  schedule_proposed_by          String?
  schedule_confirmed            Boolean  @default(false)
  staff_confirmed_completion    Boolean  @default(false)
  employer_confirmed_completion Boolean  @default(false)
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt

  // Relations
  employer    User         @relation("EmployerJobs", fields: [employer_id], references: [id])
  student     User?        @relation("StudentJobs", fields: [student_id], references: [id])
  mentor      User?        @relation("MentorJobs", fields: [mentor_id], references: [id])
  evaluations      Evaluation[]
  behavior_logs    BehaviorLog[]
  employer_reviews EmployerReview[]
  student_reviews  StudentReview[]
  mentor_reviews   MentorReview[]
  assignment_requests JobAssignmentRequest[]

  @@index([status])
  @@index([type])
  @@index([campus])
  @@index([employer_id])
  @@index([student_id])
  @@map("skc_jobs")
}

enum AssignmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model JobAssignmentRequest {
  id          String                  @id @default(uuid())
  job_id      String
  student_id  String
  status      AssignmentRequestStatus @default(PENDING)
  review_note String?
  reviewed_by String?
  reviewed_at DateTime?
  created_at  DateTime                @default(now())
  updated_at  DateTime                @updatedAt

  job     Job  @relation(fields: [job_id], references: [id])
  student User @relation("StudentAssignmentRequests", fields: [student_id], references: [id])

  @@unique([job_id, student_id])
  @@index([status])
  @@index([student_id])
  @@map("skc_job_assignment_requests")
}

// ==================== Evaluations ====================

model Evaluation {
  id             String   @id @default(uuid())
  job_id         String
  student_id     String
  teacher_id     String
  score_quality  Float    // 40%
  score_skill    Float    // 30%
  score_time     Float    // 20%
  score_tool     Float    // 10%
  weighted_score Float
  comment        String?
  eval_phase     EvalPhase @default(POST_WORK)
  nft_tx_hash    String?
  on_chain_tx    String?
  content_hash   String?
  created_at     DateTime @default(now())

  job     Job  @relation(fields: [job_id], references: [id])
  student User @relation("StudentEvaluations", fields: [student_id], references: [id])
  teacher User @relation("TeacherEvaluations", fields: [teacher_id], references: [id])

  @@map("skc_evaluations")
}

// ==================== Fund System ====================

model DonationFund {
  id               String   @id @default(uuid())
  donor_id         String
  amount           Float
  purpose          String
  is_restricted    Boolean  @default(false)
  restriction_note String?
  nft_tx_hash      String?
  created_at       DateTime @default(now())

  donor User @relation(fields: [donor_id], references: [id])

  @@map("skc_donation_funds")
}

// ==================== Reviews (Multi-source Rating) ====================

model EmployerReview {
  id                String   @id @default(uuid())
  job_id            String
  employer_id       String
  student_id        String
  score_quality     Int      // 1-5 stars
  score_punctuality Int      // 1-5 stars
  score_attitude    Int      // 1-5 stars
  overall_rating    Float
  comment           String?
  eval_phase        EvalPhase @default(POST_WORK)
  on_chain_tx       String?
  content_hash      String?
  created_at        DateTime @default(now())

  job      Job  @relation(fields: [job_id], references: [id])
  employer User @relation("EmployerGivenReviews", fields: [employer_id], references: [id])
  student  User @relation("StudentReceivedEmployerReviews", fields: [student_id], references: [id])

  @@unique([job_id, employer_id, student_id])
  @@index([student_id])
  @@index([employer_id])
  @@map("skc_employer_reviews")
}

model StudentReview {
  id              String   @id @default(uuid())
  job_id          String
  student_id      String
  employer_id     String
  score_clarity   Int      // 1-5 stars
  score_payment   Int      // 1-5 stars
  score_safety    Int      // 1-5 stars
  overall_rating  Float
  comment         String?
  eval_phase      EvalPhase @default(POST_WORK)
  on_chain_tx     String?
  content_hash    String?
  created_at      DateTime @default(now())

  job      Job  @relation(fields: [job_id], references: [id])
  student  User @relation("StudentGivenReviews", fields: [student_id], references: [id])
  employer User @relation("EmployerReceivedStudentReviews", fields: [employer_id], references: [id])

  @@unique([job_id, student_id, employer_id])
  @@index([employer_id])
  @@index([student_id])
  @@map("skc_student_reviews")
}

model MentorReview {
  id                    String   @id @default(uuid())
  job_id                String
  mentor_id             String
  trainee_id            String
  score_effort          Int      // 1-4 rubric
  score_safety          Int      // 1-4 rubric
  score_skill_dev       Int      // 1-4 rubric
  weighted_score        Float
  comment               String?
  eval_phase            EvalPhase @default(POST_WORK)
  on_chain_tx           String?
  content_hash          String?
  recommend_promotion   Boolean  @default(false)
  created_at            DateTime @default(now())

  job     Job  @relation(fields: [job_id], references: [id])
  mentor  User @relation("MentorGivenReviews", fields: [mentor_id], references: [id])
  trainee User @relation("TraineeReceivedReviews", fields: [trainee_id], references: [id])

  @@unique([job_id, mentor_id, trainee_id])
  @@index([trainee_id])
  @@index([mentor_id])
  @@map("skc_mentor_reviews")
}

// ==================== Behavior Log ====================

enum Severity {
  low
  medium
  high
  critical
}

model BehaviorLog {
  id              String   @id @default(uuid())
  user_id         String
  job_id          String?
  event_type      String
  severity        Severity @default(low)
  description     String
  penalty_applied Boolean  @default(false)
  on_chain_tx     String?
  created_at      DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
  job  Job?  @relation(fields: [job_id], references: [id])

  @@index([user_id])
  @@index([event_type])
  @@map("skc_behavior_logs")
}

// ==================== Notifications ====================

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  type       String
  title      String
  body       String
  link       String?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_id])
  @@index([user_id, is_read])
  @@map("skc_notifications")
}

// ==================== Chat ====================

model JobChatRoom {
  id          String   @id @default(uuid())
  job_id      String   @unique
  is_locked   Boolean  @default(false)
  employer_id String?
  student_id  String?
  mentor_id   String?
  created_at  DateTime @default(now())

  messages     ChatMessage[]
  participants ChatParticipant[]

  @@map("skc_job_chat_rooms")
}

model ChatMessage {
  id           String   @id @default(uuid())
  room_id      String
  sender_id    String
  content      String
  message_type String   @default("TEXT")
  content_hash String?
  metadata     Json?
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())

  room JobChatRoom @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@index([room_id, created_at])
  @@map("skc_chat_messages")
}

model ChatParticipant {
  id           String   @id @default(uuid())
  room_id      String
  user_id      String
  role_in_chat String
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())

  room JobChatRoom @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@unique([room_id, user_id])
  @@map("skc_chat_participants")
}

// ==================== Job Cancellation / Agreement ====================
// (JobAssignmentRequest defined earlier near Job model)

enum CancellationStatus {
  PENDING
  APPROVED
  REJECTED
}

model JobCancellationRequest {
  id            String             @id @default(uuid())
  job_id        String
  requested_by  String
  reason        String
  reason_detail String?
  status        CancellationStatus @default(PENDING)
  reviewed_by   String?
  reviewed_at   DateTime?
  created_at    DateTime           @default(now())

  @@index([status])
  @@map("skc_job_cancellation_requests")
}

enum AgreementStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model JobAgreement {
  id             String          @id @default(uuid())
  job_id         String
  proposed_by    String
  agreement_type String
  terms          String
  status         AgreementStatus @default(PENDING)
  accepted_by    String?
  content_hash   String?
  created_at     DateTime        @default(now())

  @@index([job_id])
  @@map("skc_job_agreements")
}

// ==================== Disputes ====================

enum DisputeStatus {
  RAISED
  UNDER_REVIEW
  MEDIATION
  RESOLVED
}

model Dispute {
  id               String        @id @default(uuid())
  job_id           String
  raised_by        String
  raised_against   String
  arbitrator_id    String?
  category         String
  description      String
  evidence_urls    Json?
  status           DisputeStatus @default(RAISED)
  resolution_terms String?
  resolved_at      DateTime?
  content_hash     String?
  created_at       DateTime      @default(now())

  @@index([job_id])
  @@index([status])
  @@map("skc_disputes")
}

// ==================== Approval Logs ====================

enum ApprovalLogAction {
  APPROVED
  REJECTED
  SUSPENDED
}

model ApprovalLog {
  id          String            @id @default(uuid())
  user_id     String
  approved_by String
  action      ApprovalLogAction
  reason      String?
  created_at  DateTime          @default(now())

  @@index([user_id])
  @@map("skc_approval_logs")
}

// ==================== Fee Config ====================

model FeeConfig {
  id          String   @id @default(uuid())
  student_bps Int      @default(8500)
  fund_bps    Int      @default(500)
  mentor_bps  Int      @default(500)
  staff_bps   Int      @default(500)
  updated_by  String?
  updated_at  DateTime @default(now()) @updatedAt

  @@map("skc_fee_config")
}

// ==================== Rating Summary Views ====================
// NOTE: These are maintained in DB (views or triggered tables).
// Prisma treats them as regular models for query typing.

model StudentRatingSummary {
  student_id            String  @id
  name                  String?
  campus                String?
  credential_level      String?
  credential_name       String?
  nft_tier              String?
  avg_teacher_score     Float?
  teacher_review_count  BigInt?
  avg_employer_rating   Float?
  employer_review_count BigInt?
  avg_mentor_score      Float?
  mentor_review_count   BigInt?
  combined_score        Float?

  @@map("skc_student_rating_summary")
}

model EmployerRatingSummary {
  employer_id  String  @id
  name         String?
  avg_rating   Float?
  review_count BigInt?
  avg_clarity  Float?
  avg_payment  Float?
  avg_safety   Float?

  @@map("skc_employer_rating_summary")
}
